# Copy this file to .env and set real values before running ./install.
# .env is gitignored and must never be committed.
GF_SECURITY_ADMIN_PASSWORD=changeme

# Token for the read-only (Viewer) Grafana service account used by mcp-grafana.
# Leave as the placeholder on first install, then create the service account in
# Grafana and replace this value (see README.md, "MCP servers").
GRAFANA_SERVICE_ACCOUNT_TOKEN=changeme
