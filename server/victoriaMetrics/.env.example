# Copy this file to .env and set real values before running ./install.
# .env is gitignored and must never be committed.
GF_SECURITY_ADMIN_PASSWORD=changeme

# Token for the read-only (Viewer) Grafana service account used by mcp-grafana.
# Leave as the placeholder on first install, then create the service account in
# Grafana and replace this value (see README.md, "MCP servers").
GRAFANA_SERVICE_ACCOUNT_TOKEN=changeme
# Host header values mcp-grafana accepts (it rejects all others with "host not allowed").
# Add the LAN address and any reverse-proxy hostname clients use, e.g.
# 192.168.1.10:8082,grafana.example.com
MCP_GRAFANA_ALLOWED_HOSTS=localhost:8082,127.0.0.1:8082

# Bearer tokens MCP clients must send ("Authorization: Bearer <token>") to each
# MCP server. Generate each one with: openssl rand -hex 32
# docker compose refuses to start the stack while any of these is unset.
MCP_VICTORIAMETRICS_AUTH_TOKEN=changeme
MCP_VICTORIALOGS_AUTH_TOKEN=changeme
MCP_GRAFANA_SERVER_TOKEN=changeme

# VictoriaLogs retention (e.g. 30d, 12w, 1y)
VICTORIALOGS_RETENTION=30d

# Watchtower image update schedule: 6-field cron (seconds first). Default
# 0 17 * * * * (every hour at :17).
# WATCHTOWER_SCHEDULE=0 17 * * * *

# Host firewall (firewall/configure, run by ./update). Unset or anything other
# than "true" = observation mode: every allow rule is in place, but traffic
# that matches none of them still flows and is only logged
# ("mon-*-unmatched:" in the journal). Set to true to drop it.
MONITORING_FIREWALL_ENFORCE=false
