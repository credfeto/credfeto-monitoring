#!/bin/sh
set -eu

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\n\033[32m✓\033[0m %s\n' "$*"
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Pairs of "volume-name:data-dir", optionally followed by ":uid:gid" when the
# container runs as a non-root user that needs to own the bind-mounted dir.
DATA_VOLUMES="victoria-metrics-data:/data/victoria-metrics grafana-data:/data/grafana:472:472"

create_data_dirs_and_volumes() {
    for pair in ${DATA_VOLUMES}; do
        volume_name="${pair%%:*}"
        rest="${pair#*:}"
        data_dir="${rest%%:*}"

        if [ -d "${data_dir}" ]; then
            info "${data_dir} already exists."
        else
            info "Creating data directory ${data_dir}..."
            sudo mkdir -p "${data_dir}"
            success "Created ${data_dir}."
        fi

        case "${rest}" in
            *:*)
                owner="${rest#*:}"
                sudo chown "${owner}" "${data_dir}"
                ;;
        esac

        if sudo docker volume inspect "${volume_name}" > /dev/null 2>&1; then
            info "Volume ${volume_name} already exists."
        else
            info "Creating Docker volume ${volume_name}..."
            sudo docker volume create \
                --opt type=none \
                --opt o=bind \
                --opt device="${data_dir}" \
                "${volume_name}"
            success "Created volume ${volume_name}."
        fi
    done
}

check_env_file() {
    if [ ! -f "${SCRIPT_DIR}/.env" ]; then
        die "Missing ${SCRIPT_DIR}/.env - copy .env.example to .env and set GF_SECURITY_ADMIN_PASSWORD before running install."
    fi
}

start_services() {
    info "Starting VictoriaMetrics and Grafana..."
    sudo docker compose up -d
    success "VictoriaMetrics and Grafana started."
}

main() {
    cd "${SCRIPT_DIR}"
    check_env_file
    create_data_dirs_and_volumes
    start_services
    success "Installation complete."
}

main
