# Ingress filter for the published container ports. Generated by ./configure
# from ingress.nft.template - edit the template, not /etc/credfeto-monitoring.
#
# Docker DNATs published ports itself, and firewalld accepts all DNATed
# forwarded traffic, so this has to be a table of its own. Its forward chain
# runs before Docker's and firewalld's (priority filter - 10) and only looks
# at new DNATed connections arriving from outside the Docker bridges, matching
# the original (published) destination port. Everything else is untouched.
#
# The first two lines make loading the file replace the table atomically.
table inet mon_ingress {}
delete table inet mon_ingress

table inet mon_ingress {
    set lan4 {
        type ipv4_addr
        flags interval
        elements = { @LAN4@ }
    }
    set lan6 {
        type ipv6_addr
        flags interval
        elements = { @LAN6@ }
    }
    set proxies4 {
        type ipv4_addr
        elements = { @PROXIES4@ }
    }
    set proxies6 {
        type ipv6_addr
        elements = { @PROXIES6@ }
    }

    chain forward {
        type filter hook forward priority filter - 10; policy accept;
        ct state new ct status dnat iifname != "docker0" iifname != "br-*" jump published
    }

    chain published {
        # Central logging: syslog (514 tcp/udp) and the VictoriaLogs ingest
        # (9428: journald uploads, the Technitium Log Exporter) from the LAN.
        meta l4proto { tcp, udp } ct original proto-dst 514 ip saddr @lan4 accept
        meta l4proto { tcp, udp } ct original proto-dst 514 ip6 saddr @lan6 accept
        meta l4proto tcp ct original proto-dst 9428 ip saddr @lan4 accept
        meta l4proto tcp ct original proto-dst 9428 ip6 saddr @lan6 accept
        # Grafana, metrics ingest (Telegraf, Proxmox) and the MCP servers,
        # from the reverse proxies only.
        meta l4proto tcp ct original proto-dst { 3000, 8428, 8081, 8082, 8083 } ip saddr @proxies4 accept
        meta l4proto tcp ct original proto-dst { 3000, 8428, 8081, 8082, 8083 } ip6 saddr @proxies6 accept
        limit rate 30/minute log prefix "mon-ingress-unmatched: " level info
        @INGRESS_ACTION@
    }
}
